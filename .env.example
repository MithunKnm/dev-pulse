# Hugging Face Inference (langchain-huggingface expects this name)
HUGGINGFACEHUB_API_TOKEN=""
HUGGINGFACE_MODEL="Qwen/Qwen2.5-7B-Instruct"

# GitHub MCP — generate a PAT at https://github.com/settings/tokens with public_repo scope
GITHUB_PERSONAL_ACCESS_TOKEN=""

# Test target
TEST_GITHUB_REPO="octocat/Hello-World"
TEST_GITHUB_USERNAME="octocat"