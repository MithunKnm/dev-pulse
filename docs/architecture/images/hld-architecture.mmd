graph TB
    subgraph Client_Layer
        FE[React Frontend]
    end

    subgraph API_Layer
        API[FastAPI + Uvicorn]
    end

    subgraph Orchestration_Layer
        LG[LangGraph StateGraph]
    end

    subgraph Integration_Layer
        MCP[GitHub MCP Client]
        HF[Hugging Face LLM]
    end

    subgraph Data_Layer
        DB[(PostgreSQL - Placeholder)]
    end

    subgraph External_Services
        GH[GitHub API]
        HFAPI[HF Inference API]
    end

    FE -- HTTP POST --> API
    API -- run_pipeline --> LG
    LG -- fetch_github_data --> MCP
    LG -- generate_ai_report --> HF
    LG -- persist_to_db --> DB
    MCP -- stdio JSON-RPC --> GH
    HF -- HTTPS --> HFAPI
